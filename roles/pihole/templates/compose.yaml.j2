---
# Managed by Ansible (roles/pihole). Local edits will be overwritten.
services:
  pihole:
    container_name: {{ pihole_container_name }}
    image: {{ pihole_image }}
    restart: unless-stopped
    # Host networking, like Home Assistant, so Pi-hole sees each LAN client's
    # real address in its query log instead of the Docker bridge gateway.
    network_mode: host
    environment:
      TZ: {{ pihole_timezone }}
      FTLCONF_webserver_port: "{{ pihole_web_port }}"
      FTLCONF_dns_upstreams: "{{ pihole_dns_upstreams }}"
      FTLCONF_dns_domain_name: "{{ pihole_dns_domain }}"
      FTLCONF_dhcp_active: "{{ pihole_dhcp_enabled | bool | lower }}"
{% if pihole_dhcp_enabled | bool %}
      FTLCONF_dhcp_start: "{{ pihole_dhcp_start }}"
      FTLCONF_dhcp_end: "{{ pihole_dhcp_end }}"
      FTLCONF_dhcp_router: "{{ pihole_dhcp_router }}"
      FTLCONF_dhcp_netmask: "{{ pihole_dhcp_netmask }}"
      FTLCONF_dhcp_leaseTime: "{{ pihole_dhcp_lease_time }}"
      FTLCONF_dhcp_ipv6: "false"
      # One static lease per line, as the FTLCONF array examples show.
      FTLCONF_dhcp_hosts: |-
{% for host in pihole_dhcp_hosts %}
        {{ host }}
{% endfor %}
{% endif %}
      WEBPASSWORD_FILE: pihole_webpasswd
    secrets:
      - pihole_webpasswd
    volumes:
      - ./etc-pihole:/etc/pihole
    cap_add:
{% if pihole_dhcp_enabled | bool %}
      # Required by the DHCP server to answer on port 67.
      - NET_ADMIN
{% endif %}
      - SYS_NICE

secrets:
  pihole_webpasswd:
    file: ./{{ pihole_password_file }}
